#!/bin/bash
#SBATCH --job-name=bl_ae
#SBATCH --partition=gpu
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=8
#SBATCH --gres=gpu:nvidia_a100:1
#SBATCH --mem=64G --time=06:00:00
#SBATCH --output=results/logs/bl_ae_%j.out
#SBATCH --error=results/logs/bl_ae_%j.err

# ONE paper-spec AE shared by all 4 conditioning baselines, so ONLY the conditioning differs.
# models.Autoencoder3D and models_spatial.Autoencoder3D are structurally identical, so this
# checkpoint loads strict into the spatial family too.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/home/sz3962/.conda/envs/taugennet/bin/python3     # EDIT
cd /scratch/network/sz3962/taugennet                   # EDIT
OUT=results/checkpoints/baselines/ae/fold_0
mkdir -p $OUT results/logs
set -e
$PY scripts/train.py --mode ptau217 --fold 0 --n-folds 5 --use-mentor-split --use-mask \
    --ae-epochs 500 --diff-epochs 0 --batch-size 4 \
    --latent-ch 3 --latent-scale 8 --ae-res-blocks 2 --kl-weight 1e-5 \
    --patience 50 --ae-val-every 5 \
    --ae-checkpoint $OUT/taugennet_checkpoint.pt --checkpoint-dir $OUT
rm -f $OUT/taugennet_checkpoint.pt
