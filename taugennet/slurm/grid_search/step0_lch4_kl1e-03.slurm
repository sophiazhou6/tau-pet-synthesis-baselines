#!/bin/bash
#SBATCH --job-name=gs_s0_lch4_kl1e-03
#SBATCH --array=0-4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:nvidia_a100:1
#SBATCH --mem=64G
#SBATCH --time=04:30:00
#SBATCH --output=results/logs/gs_s0_lch4_kl1e-03_%A_%a.out
#SBATCH --error=results/logs/gs_s0_lch4_kl1e-03_%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=sz3962@princeton.edu

# Grid search Stage 0 (screen): latent_ch=4, kl_weight=0.001, AE-only.
# One array task per screened fold (screen_folds=5 of 5).
# Generated by run_grid_search.py --step 0 — do NOT edit by hand.

PYTHON=/home/sz3962/.conda/envs/taugennet/bin/python3
FOLD=$SLURM_ARRAY_TASK_ID
N_FOLDS=5
AE_CKPT=results/checkpoints/grid_search/step0/lch4_kl1e-03/fold_${FOLD}/taugennet_checkpoint.pt
AE_BEST=results/checkpoints/grid_search/step0/lch4_kl1e-03/fold_${FOLD}/taugennet_checkpoint_best.pt
METRICS=results/checkpoints/grid_search/step0/lch4_kl1e-03/fold_${FOLD}/recon_metrics.json

cd /scratch/network/sz3962/taugennet
mkdir -p results/logs results/checkpoints/grid_search/step0/lch4_kl1e-03/fold_${FOLD}

echo "=== Stage 0: lch4_kl1e-03, fold ${FOLD}/${N_FOLDS} (AE screen) ==="
echo "Job: $SLURM_JOB_ID  Array: $SLURM_ARRAY_TASK_ID  Node: $SLURM_NODELIST  Start: $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""
set -e   # fail loudly: if AE training crashes, the job FAILS (not fake-COMPLETED)

echo "=== AE training ==="
$PYTHON scripts/train.py \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS \
    --ae-epochs 500 --diff-epochs 0 \
    --latent-ch 4 --kl-weight 0.001 \
    --patience 50 --ae-val-every 5 \
    --ae-checkpoint $AE_CKPT

echo "=== Masked recon on val (selection metric) ==="
$PYTHON scripts/eval_ae_recon.py \
    --checkpoint $AE_BEST \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS --split val \
    --use-mask --no-figures \
    --metrics-out $METRICS

rm -f "$AE_CKPT"
echo "Fold ${FOLD} complete. End: $(date)"
