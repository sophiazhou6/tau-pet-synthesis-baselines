#!/bin/bash
#SBATCH --job-name=gs_s1_lch4_kl1e-04
#SBATCH --array=0-4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:nvidia_a100:1
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=results/logs/gs_s1_lch4_kl1e-04_%A_%a.out
#SBATCH --error=results/logs/gs_s1_lch4_kl1e-04_%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=sz3962@princeton.edu

# Grid search Stage 1 (decide): latent_ch=4, kl_weight=0.0001, full pipeline.
# One array task per fold. Generated by run_grid_search.py --step 1.

PYTHON=/home/sz3962/.conda/envs/taugennet/bin/python3
FOLD=$SLURM_ARRAY_TASK_ID
N_FOLDS=5
AE_CKPT=results/checkpoints/grid_search/step1/lch4_kl1e-04/fold_${FOLD}/taugennet_checkpoint.pt

cd /scratch/network/sz3962/taugennet
mkdir -p results/logs results/checkpoints/grid_search/step1/lch4_kl1e-04/fold_${FOLD}/atrophy

echo "=== Stage 1: lch4_kl1e-04, fold ${FOLD}/${N_FOLDS} (AE + diffusion) ==="
echo "Job: $SLURM_JOB_ID  Array: $SLURM_ARRAY_TASK_ID  Node: $SLURM_NODELIST  Start: $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

echo "=== AE training ==="
$PYTHON scripts/train.py \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS \
    --ae-epochs 100 --diff-epochs 0 \
    --latent-ch 4 --kl-weight 0.0001 \
    --ae-checkpoint $AE_CKPT
echo "AE done at: $(date)"

echo "=== Diffusion training ==="
$PYTHON scripts/train.py \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS \
    --skip-ae --ae-checkpoint $AE_CKPT \
    --checkpoint-dir results/checkpoints/grid_search/step1/lch4_kl1e-04/fold_${FOLD}/atrophy \
    --latent-ch 4 --kl-weight 0.0001 \
    --diff-epochs 2000 --patience 50 \
    --val-every 1 --monitor-every 50 \
    --lr 0.0001
echo "Fold ${FOLD} complete. End: $(date)"
