#!/bin/bash
#SBATCH --job-name=gs_s0_lch8_kl1e-05
#SBATCH --array=0-4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:nvidia_h100_nvl:1
#SBATCH --mem=64G
#SBATCH --time=04:30:00
#SBATCH --output=results/logs/gs_s0_lch8_kl1e-05_%A_%a.out
#SBATCH --error=results/logs/gs_s0_lch8_kl1e-05_%A_%a.err

# Grid search Stage 0 (screen): latent_ch=8, kl_weight=1e-05, AE-only.
# One array task per screened fold (screen_folds=5 of 5).
# Generated by run_grid_search.py --step 0 — do NOT edit by hand.

PYTHON=/usr/bin/python3.9
FOLD=$SLURM_ARRAY_TASK_ID
N_FOLDS=5
AE_CKPT=results/checkpoints/grid_search/step0/lch8_kl1e-05/fold_${FOLD}/taugennet_checkpoint.pt
AE_BEST=results/checkpoints/grid_search/step0/lch8_kl1e-05/fold_${FOLD}/taugennet_checkpoint_best.pt
METRICS=results/checkpoints/grid_search/step0/lch8_kl1e-05/fold_${FOLD}/recon_metrics.json

cd /home/remote/adebnath1/taugennet
export PYTHONPATH="/home/remote/adebnath1/.local/lib/python3.9/site-packages:/home/remote/adebnath1/taugennet:$PYTHONPATH"
export TAUGENNET_ROOT="/home/remote/adebnath1/taugennet"
source scripts/wait_for_fac.sh
mkdir -p results/logs results/checkpoints/grid_search/step0/lch8_kl1e-05/fold_${FOLD}

echo "=== Stage 0: lch8_kl1e-05, fold ${FOLD}/${N_FOLDS} (AE screen) ==="
echo "Job: $SLURM_JOB_ID  Array: $SLURM_ARRAY_TASK_ID  Node: $SLURM_NODELIST  Start: $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""
set -e   # fail loudly: if AE training crashes, the job FAILS (not fake-COMPLETED)

echo "=== AE training ==="
$PYTHON scripts/train.py \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS \
    --ae-epochs 500 --diff-epochs 0 \
    --latent-ch 8 --kl-weight 1e-05 \
    --patience 50 --ae-val-every 5 \
    --ae-checkpoint $AE_CKPT

echo "=== Masked recon on val (selection metric) ==="
$PYTHON scripts/eval_ae_recon.py \
    --checkpoint $AE_BEST \
    --mode atrophy \
    --fold $FOLD --n-folds $N_FOLDS --split val \
    --use-mask --no-figures \
    --metrics-out $METRICS

rm -f "$AE_CKPT"
echo "Fold ${FOLD} complete. End: $(date)"
